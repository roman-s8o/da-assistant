# Copy this file to .env and fill in the values.

# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud project that pays for BigQuery jobs.
# Leave it empty to use the default project of your gcloud credentials.
DA_GCP_PROJECT=

# Optional overrides. The defaults are shown.
# DA_LLM_MODEL=gemini-3.8-flash
# DA_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# DA_GUARD_MODEL=gemini-3.5-flash-lite
# DA_DB_PATH=data/assistant.db
# DA_MAX_BYTES_BILLED=1000000000
